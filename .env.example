# Optional; Compose injects this file's variables into the application.
# false publishes actual commands; true observes without publishing.
CARSTATE_DRY_RUN=false
# For config/secrets.env.example.json5, supply MQTT values (empty is distinct from unset).
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=carstate_garage
HTTP_STATE_TOKEN=
